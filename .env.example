# â”€â”€ EduBot Docker Environment Configuration â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# Ollama Host URL:
# - Default: "http://ollama:11434" (uses the containerized ollama service in docker-compose)
# - To connect to Ollama on the host machine instead: "http://host.docker.internal:11434"
OLLAMA_HOST=http://ollama:11434

# The Ollama model to automatically download and use
OLLAMA_MODEL=qwen2.5:7b-instruct

# Port on the host machine where the Gradio Web Chat UI is exposed
GRADIO_PORT=7860

# Port on the host machine where the Ollama service is exposed
OLLAMA_PORT=11434
